generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  steamId        String   @unique
  username       String
  avatar         String
  balance        Float    @default(500)
  usedDimasPromo Boolean  @default(false)
  bets           Bet[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([steamId])
}

model Round {
  id             Int      @id @default(autoincrement())
  serverSeedHash String
  serverSeed     String
  clientSeed     String
  nonce          Int
  winningColor   String
  winningNumber  Int
  status         String   @default("finished")
  bets           Bet[]
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model Bet {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roundId   Int
  round     Round    @relation(fields: [roundId], references: [id])
  color     String
  amount    Float
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([roundId])
}
